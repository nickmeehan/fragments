#!/usr/bin/env bash
# Prints version=X.Y.Z for the release a merge to main would cut, or nothing when there is nothing to
# release. Reads Conventional Commit subjects since the last v* tag (all commits when there is none):
# feat → minor, fix/perf → patch, anything else (docs, chore, refactor, test, ci, merges) → no release.
# Works for squash merges (PR title is the subject) and merge commits (the PR's commits are in range).
# ponytail: major never bumps on its own; 1.0 is a decision, cut it via release.yml's workflow_dispatch.
set -euo pipefail
cd "$(dirname "$0")/.."
if last=$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null); then
  range="$last..HEAD"
else
  last=v0.0.0; range=HEAD
fi
subjects=$(git log --format=%s "$range")
IFS=. read -r major minor patch <<< "${last#v}"
if grep -Eq '^feat(\(.*\))?!?:' <<< "$subjects"; then
  echo "version=$major.$((minor + 1)).0"
elif grep -Eq '^(fix|perf)(\(.*\))?!?:' <<< "$subjects"; then
  echo "version=$major.$minor.$((patch + 1))"
fi
