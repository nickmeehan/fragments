#!/usr/bin/env bash
# Drives the real Rex and Claude Code the way ⌘⇧↩, ↩, t, ⌘D and opening the list do, with a harmless prompt: start a
# session, attach while it's alive, title it and attach again, rename it in Rex and read the name back as the title,
# clear the title, kill it, attach again (the conversation resumes in a new session, whose id comes back), end it the
# way trashing the fragment does, end it again. No test reaches these two; this does.
# Run it on Nick's Mac after changing FragmentsCore/Actions/rex or updating Rex. Needs Rex running with Remote Control
# on, and Claude Code signed in. The session runs in this checkout, a folder Claude already trusts, at low effort, and
# is told to use no tools.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
swift build --package-path FragmentsCore --product Rex -q
program=$(swift build --package-path FragmentsCore --product Rex --show-bin-path)/Rex
token=fragments-check-$RANDOM
id=$(date +%Y%m%d-%H%M%S)-c0de
label=frag-$id
rexid=""
trap 'rex session kill "$label" > /dev/null 2>&1; [ -z "$rexid" ] || rex session kill "$rexid" > /dev/null 2>&1; true' EXIT
# A leading dash, a quote, double quotes and a dollar sign: each must reach Claude as typed.
prompt="--check it's \"quoted\" \$HOME: reply with exactly $token and nothing else, using no tools"

# The fragment as Fragments sends it: $1 Rex's session, $2 Claude's conversation, $3 a title.
fragment() {
  local session="" title=""
  if [ -n "${1:-}" ]; then session=",\"session\":{\"id\":\"$1\",\"resume\":\"$2\",\"folder\":\"$root\"}"; fi
  if [ -n "${3:-}" ]; then title=",\"title\":\"$3\""; fi
  printf '{"id":"%s","created":"2026-01-01T00:00:00Z","text":"%s","action":"rex"%s%s}' \
    "$id" "${prompt//\"/\\\"}" "$session" "$title"
}

# Runs the program as the app does: launchd's bare environment, a login zsh, LoginShell.pathLine. `titles` takes a list
# of fragments, every other verb one.
run() {
  local verb=$1 key=fragment open="" close=""
  shift
  if [ "$verb" = titles ]; then key=fragments open="[" close="]"; fi
  printf '{"%s":%s%s%s,"settings":{"folder":"%s","effort":"low"}}' "$key" "$open" "$(fragment "$@")" "$close" "$root" |
    env -i HOME="$HOME" USER="$USER" SHELL=/bin/zsh /bin/zsh -lc \
      'export PATH="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; "$0" "$1"' \
      "$program" "$verb"
}
fail() { echo "✗ $1" >&2; exit 1; }
sessions() { rex session ls | grep -c -e "$label" -e "$token" || true; }
field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }

started=$(run start) || fail "start: $started"
rexid=$(echo "$started" | field id)
sid=$(echo "$started" | field resume)
[ -n "$rexid" ] && [ -n "$sid" ] || fail "start didn't print a session: $started"
echo "✓ start returned Rex session $rexid ($label), resuming Claude conversation $sid"

transcript=""
for _ in $(seq 90); do
  transcript=$(find ~/.claude/projects -name "$sid.jsonl" 2>/dev/null | head -1)
  [ -n "$transcript" ] && grep '"type":"assistant"' "$transcript" | grep -q "$token" && break
  sleep 1
done
[ -n "$transcript" ] || fail "Claude kept no conversation under $sid (a trust or onboarding prompt in the session?)"
grep '"type":"assistant"' "$transcript" | grep -q "$token" || fail "Claude didn't answer within 90s: rex capture -s $label"
grep '"type":"user"' "$transcript" | grep -qF -e "--check it's \\\"quoted\\\" \$HOME" || fail "the prompt arrived changed"
echo "✓ Claude got the prompt as typed and answered, under the conversation id start returned"

kept=$(run attach "$rexid" "$sid") || fail "attach to the live session failed: $kept"
[ "$(sessions)" = 1 ] || fail "attach to a live session started another"
[ "$(echo "$kept" | field id)" = "$rexid" ] || fail "attach to a live session handed back another: $kept"
echo "✓ attach showed the live session and handed it back"

title="-check $token"  # a leading dash must stay a name, not become a flag
run retitle "$rexid" "$sid" "$title" > /dev/null || fail "retitle failed"
rex session inspect --json -- "$rexid" | grep -qF "\"label\": \"$title\"" || fail "retitle didn't rename the session"
run attach "$rexid" "$sid" "$title" > /dev/null || fail "attach to the renamed session failed"
[ "$(sessions)" = 1 ] || fail "attach to a renamed session started another"
echo "✓ retitle named the session after the title, and attach still found it"

renamed="Renamed $token"
rex session rename -- "$rexid" "$renamed" > /dev/null
run titles "$rexid" "$sid" "$title" | grep -qF "\"$id\":\"$renamed\"" || fail "titles didn't read back Rex's name"
run retitle "$rexid" "$sid" > /dev/null || fail "clearing the title failed"
rex session inspect --json -- "$label" > /dev/null || fail "clearing the title didn't name the session $label again"
run titles "$rexid" "$sid" | grep -qF "\"$id\":null" || fail "titles didn't read $label as no title"
echo "✓ a name changed in Rex comes back as the title, and $label as none"

rex session kill "$label" > /dev/null
reopened=$(run attach "$rexid" "$sid") || fail "attach after the session was gone failed: $reopened"
rexid=$(echo "$reopened" | field id)
rex session inspect --json -- "$label" | grep -qF "\"session_id\": \"$rexid\"" ||
  fail "attach didn't hand back the session it started again: $reopened"
for _ in $(seq 30); do rex capture -s "$label" | grep -q "$token" && break; sleep 1; done
rex capture -s "$label" | grep -q "$token" || fail "the resumed session doesn't show the conversation"
echo "✓ attach resumed the conversation once Rex had lost the session, and handed back the new one"

run end "$rexid" "$sid" > /dev/null || fail "end failed"
if rex session inspect --json -- "$rexid" > /dev/null 2>&1; then fail "end left the session running"; fi
[ "$(sessions)" = 0 ] || fail "end left a session behind"
[ -s "$transcript" ] || fail "end lost the conversation, so a fragment out of the Trash couldn't resume it"
run end "$rexid" "$sid" > /dev/null || fail "end of a session that's already gone failed"
echo "✓ end closed the session and kept the conversation; ending it again did nothing"
